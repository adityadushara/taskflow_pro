# ==============================================================================
# Flask Backend Environment Configuration
# ==============================================================================
FLASK_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Supabase Server Settings (Never commit actual keys)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Service Settings (Direct Gmail Integration - requires Google App Password or Webhook)
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
EMAIL_FROM=Hairdrama Tasks <your_email@gmail.com>
# Optional: Google Mail Webhook URL (if using Google Apps Script deployment)
# GMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec
