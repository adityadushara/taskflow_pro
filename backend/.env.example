# ==============================================================================
# Flask Backend Environment Configuration
# ==============================================================================
FLASK_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Supabase Server Settings (Never commit actual keys)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Service Settings (Option A: Resend API with domain, or Option B: Gmail directly)
# Option A: Resend
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_placeholder
EMAIL_FROM=Hairdrama Tasks <onboarding@resend.dev>

# Option B: Direct Gmail (No domain needed - requires Google App Password)
# EMAIL_PROVIDER=gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_char_google_app_password
# EMAIL_FROM=Hairdrama Tasks <your_email@gmail.com>
