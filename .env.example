# ==============================================================================
# Task Management App - Environment Configuration Example
# ==============================================================================
# Copy this file to create your local environment files:
#   - frontend/.env.local (Frontend configuration)
#   - backend/.env        (Backend configuration)
#
# IMPORTANT SECURITY RULES:
# - NEVER commit actual .env or .env.local files containing real secrets.
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend (NEXT_PUBLIC_ prefix).
# - Service-role key bypasses Row Level Security (RLS) and is strictly server-only.
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (frontend/.env.local)
# ------------------------------------------------------------------------------
# Supabase project URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Publishable API key (safe for browser exposure with RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_publishable_key

# Flask Backend REST API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (backend/.env)
# ------------------------------------------------------------------------------
# Flask Server Environment
FLASK_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Supabase Server Configuration
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (SERVER-ONLY: Bypasses RLS for admin operations)
# NEVER EXPOSE THIS KEY TO THE BROWSER OR FRONTEND CODE.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Supabase JWT Secret (optional, used for local JWT verification if needed)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Google OAuth Credentials (configured in Supabase Auth & Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Service Configuration (Direct Gmail Integration)
# Supported providers: "gmail", "smtp", "gmail_webhook", "none"
EMAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
EMAIL_FROM=Hairdrama Tasks <your_email@gmail.com>
# Optional: Google Apps Script Webhook
# GMAIL_WEBHOOK_URL=https://script.google.com/macros/s/your-script-id/exec
